# Red Clover Studio — API keys. You don't need to edit this file by hand:
# ⚙︎ → Connections in the app writes these lines into .env for you.
# NEVER commit .env. Keys are used on your computer only and never sent to the browser.

# fal.ai — video (MiniMax H3 / H3 Max, Seedance, Kling, Wan), GPT Image, lip sync, sound effects
FAL_KEY=

# Atlas Cloud — optional second source for Seedance 2.5
ATLAS_API_KEY=

# Google Gemini — storyboard and vault images (Nano Banana)
GEMINI_API_KEY=

# ElevenLabs — character voices (your own account, so your voices are available)
ELEVENLABS_API_KEY=

# Claude helpers — either a direct Anthropic key, or OpenRouter (used when there's no Anthropic key)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides. Normally the app asks for the projects folder on first run and saves it in
# ~/.red-clover-studio/settings.json.
# RCS_PROJECT_ROOT=
# PORT=8099
